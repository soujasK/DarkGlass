# Copy to backend/.env. Every setting is optional; defaults are shown.

# FalkorDB
DARKGLASS_FALKORDB_HOST=localhost
DARKGLASS_FALKORDB_PORT=6390

# Gemini on Vertex AI, for the LLM agent and Ask the graph (the Playbook agent needs none of this).
# Run `gcloud auth application-default login`, then set your project:
# DARKGLASS_VERTEX_PROJECT_ID=your-gcp-project-id
# DARKGLASS_VERTEX_REGION=global
# DARKGLASS_GEMINI_MODEL=gemini-3.8-flash
