# Copy to backend/.env. Every setting is optional; defaults are shown.

# FalkorDB
DARKGLASS_FALKORDB_HOST=localhost
DARKGLASS_FALKORDB_PORT=6390

# Claude mode for the agent (the default "auto" playbook needs none of this).
# Option A - Anthropic API: set ANTHROPIC_API_KEY, keep provider "anthropic".
# Option B - Google Cloud Vertex AI: run `gcloud auth application-default login`, then:
DARKGLASS_LLM_PROVIDER=anthropic
# DARKGLASS_LLM_PROVIDER=vertex
# DARKGLASS_VERTEX_PROJECT_ID=your-gcp-project-id
# DARKGLASS_VERTEX_REGION=global
DARKGLASS_ANTHROPIC_MODEL=claude-opus-5-5
